<?xml version="1.0" encoding="utf-8"?>
<!-- Microsoft Store package. Identity and publisher come from Partner Center (Product identity);
     {VERSION} is filled in from Cargo.toml by store/build.py. -->
<Package
  xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
  xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
  xmlns:desktop="http://schemas.microsoft.com/appx/manifest/desktop/windows10"
  xmlns:rescap="http://schemas.microsoft.com/appx/manifest/foundation/windows10/restrictedcapabilities"
  IgnorableNamespaces="uap desktop rescap">

  <Identity
    Name="LamKieu.TaskbarMonitor"
    Publisher="CN=B4DA8985-8432-44DD-8D60-4D3D5DBBCAD8"
    Version="{VERSION}"
    ProcessorArchitecture="x64" />

  <Properties>
    <DisplayName>Taskbar Monitor</DisplayName>
    <PublisherDisplayName>Lam Kieu</PublisherDisplayName>
    <Logo>Assets\StoreLogo.png</Logo>
  </Properties>

  <Dependencies>
    <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.22000.0" MaxVersionTested="10.0.26100.0" />
  </Dependencies>

  <Resources>
    <Resource Language="en-us" />
  </Resources>

  <Applications>
    <Application Id="TaskbarMonitor" Executable="taskbar-monitor.exe" EntryPoint="Windows.FullTrustApplication">
      <uap:VisualElements
        DisplayName="Taskbar Monitor"
        Description="CPU, GPU, VRAM and RAM usage on the Windows taskbar."
        BackgroundColor="transparent"
        Square150x150Logo="Assets\Square150x150Logo.png"
        Square44x44Logo="Assets\Square44x44Logo.png">
        <uap:DefaultTile Wide310x150Logo="Assets\Wide310x150Logo.png" />
      </uap:VisualElements>
      <Extensions>
        <desktop:Extension Category="windows.startupTask" Executable="taskbar-monitor.exe" EntryPoint="Windows.FullTrustApplication">
          <desktop:StartupTask TaskId="TaskbarMonitor" Enabled="true" DisplayName="Taskbar Monitor" />
        </desktop:Extension>
      </Extensions>
    </Application>
  </Applications>

  <Capabilities>
    <rescap:Capability Name="runFullTrust" />
  </Capabilities>
</Package>
